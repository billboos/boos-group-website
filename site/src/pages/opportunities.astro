---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'opportunities');
if (!page) throw new Error('Missing required content entry: pages/opportunities.md');
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <div class="max-w-3xl mx-auto px-4 py-8 sm:py-10">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-8">{page.data.title}</h1>
    <article class="prose prose-blue dark:prose-invert max-w-none">
      <Content />
    </article>
  </div>
</Layout>
