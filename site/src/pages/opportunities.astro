---
import Layout from '../layouts/Layout.astro';
import { Mail } from 'lucide-react';
import { getEntry, render } from 'astro:content';
import { SITE } from '../config';

const page = await getEntry('pages', 'opportunities');
if (!page) throw new Error('Missing required content entry: pages/opportunities.md');
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <div class="max-w-3xl mx-auto px-4 py-8 sm:py-10">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-8">{page.data.title}</h1>
    <article class="prose prose-blue dark:prose-invert max-w-none">
      <Content />
    </article>

    <div class="mt-8 bg-gray-50 dark:bg-gray-900 rounded-3xl p-8 sm:p-12 text-center border border-gray-100 dark:border-gray-800">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">Questions?</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
        Email William Boos with questions about these positions.
      </p>
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 bg-berkeley-blue text-white px-8 py-3 rounded-full font-medium hover:bg-blue-900 transition-colors">
        <Mail className="w-5 h-5" aria-hidden="true" />
        <span>Email {SITE.email}</span>
      </a>
    </div>
  </div>
</Layout>
