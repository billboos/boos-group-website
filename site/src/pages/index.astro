---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Users, BookOpen, Database } from 'lucide-react';
import { SITE } from '../config';

import bangladeshMonsoon from '../assets/gallery/bangladesh-monsoon.jpg';
import northAmericanMonsoon from '../assets/gallery/north-american-monsoon.jpg';
import saharaDust from '../assets/gallery/sahara-dust.jpg';
import somaliJet from '../assets/gallery/somali-jet.jpg';

const papers = (await getCollection('publications'))
  .filter((p) => p.data.type === 'paper' && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const gallery = [
  {
    image: bangladeshMonsoon,
    alt: 'Satellite view of thick white cloud bands over the Bay of Bengal and the green Bangladesh delta during the summer monsoon.',
    caption: 'Bangladesh during the summer monsoon, seen from the ISS. NASA, 2002.',
  },
  {
    image: northAmericanMonsoon,
    alt: 'Satellite view of scattered deep convective storm clouds over Mexico and the southwestern United States.',
    caption: 'North American monsoon convection.',
  },
  {
    image: saharaDust,
    alt: 'Satellite view of a tan dust plume streaming off the North African coast over the Atlantic Ocean.',
    caption: 'Dust from the North African heat low.',
  },
  {
    image: somaliJet,
    alt: 'Satellite view of swirling green and blue phytoplankton patterns in the Arabian Sea driven by coastal upwelling.',
    caption: 'The Somali jet over the Arabian Sea.',
  },
];

const sectionCards = [
  {
    href: '/team',
    icon: Users,
    label: 'People',
    description: "Meet the group's current members, the India-based forecasting team, and alumni.",
  },
  {
    href: '/publications',
    icon: BookOpen,
    label: 'Publications',
    description: 'Peer-reviewed research on monsoons, atmospheric dynamics, and extreme weather.',
  },
  {
    href: '/data-tools',
    icon: Database,
    label: 'Data & Tools',
    description: 'Operational forecasts, track datasets, and models produced by the group.',
  },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative h-[75vh] min-h-[520px] flex items-end overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image
        src={SITE.hero.image}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        quality={70}
        format="webp"
        widths={[640, 1024, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
      />
      <!-- Deep navy scrim: guarantees AA contrast for the title regardless of the image underneath -->
      <div class="absolute inset-0 bg-berkeley-scrim/80"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20 w-full">
      <h1 class="text-4xl sm:text-6xl font-bold text-white leading-tight mb-6 max-w-3xl">
        {SITE.hero.title}
      </h1>
      <p class="text-lg sm:text-2xl text-berkeley-tint max-w-2xl">
        {SITE.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Static image gallery: all four images always visible, no rotation -->
  <section class="py-16 sm:py-20 bg-white dark:bg-gray-950" aria-labelledby="gallery-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="gallery-heading" class="sr-only">Satellite imagery of the phenomena we study</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {gallery.map((item) => (
          <figure class="group">
            <div class="rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-900 aspect-[4/3]">
              <Image
                src={item.image}
                alt={item.alt}
                loading="lazy"
                quality={70}
                format="webp"
                widths={[320, 480]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <figcaption class="mt-3 text-sm text-gray-600 dark:text-gray-400">{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Section cards -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-3">
        {sectionCards.map((card) => (
          <a
            href={card.href}
            class="group bg-white dark:bg-gray-950 rounded-xl border border-gray-100 dark:border-gray-800 p-8 hover:shadow-md transition-all hover:-translate-y-0.5"
          >
            <div class="w-12 h-12 rounded-xl bg-berkeley-tint dark:bg-blue-950 text-berkeley-blue dark:text-blue-300 flex items-center justify-center mb-5">
              <card.icon className="w-6 h-6" aria-hidden="true" />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-berkeley-link dark:group-hover:text-blue-400">
              {card.label}
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{card.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Selected Publications -->
  <section class="py-16 sm:py-20 bg-white dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Selected publications</h2>
        <a href="/publications" class="text-berkeley-link dark:text-blue-300 hover:underline font-medium flex items-center gap-1 group">
          <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {papers.map((paper) => {
          const link = paper.data.links?.website || paper.data.links?.pdf || (paper.data.doi ? `https://doi.org/${paper.data.doi}` : '/publications');
          return (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-100 dark:border-gray-800 hover:shadow-md transition-all hover:-translate-y-1 p-6 flex flex-col h-full group"
            >
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2 line-clamp-3 group-hover:text-berkeley-link dark:group-hover:text-blue-400 transition-colors">
                {paper.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm line-clamp-2 flex-grow" title={paper.data.authors.join(', ')}>
                {paper.data.authors.length > 3
                  ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.`
                  : paper.data.authors.join(', ')}
              </p>
              <div class="flex items-center justify-between text-sm mt-auto gap-4">
                <span class="font-medium text-berkeley-link dark:text-blue-300 bg-berkeley-tint dark:bg-blue-950 px-2 py-1 rounded truncate max-w-full" title={paper.data.venue}>
                  {paper.data.venue}
                </span>
                <span class="text-gray-500 dark:text-gray-400 shrink-0">{paper.data.year}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Latest news</h2>
        <a href="/news" class="text-berkeley-link dark:text-blue-300 hover:underline font-medium flex items-center gap-1 group">
          <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {news.map((item) => (
          <div class="bg-white dark:bg-gray-950 rounded-xl border border-gray-100 dark:border-gray-800 p-6">
            <time datetime={item.data.date.toISOString()} class="text-sm text-gray-500 dark:text-gray-400">
              {item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mt-2 mb-3 line-clamp-3">{item.data.title}</h3>
            {item.data.link && (
              <a href={item.data.link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-berkeley-link dark:text-blue-300 hover:underline">
                View on Bluesky
              </a>
            )}
          </div>
        ))}

        {news.length === 0 && (
          <p class="text-gray-500 dark:text-gray-400 italic">No news yet.</p>
        )}
      </div>
    </div>
  </section>
</Layout>
