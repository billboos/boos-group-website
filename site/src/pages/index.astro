---
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Users, BookOpen, Database } from 'lucide-react';
import { SITE } from '../config';

const papers = (await getCollection('publications'))
  .filter((p) => p.data.type === 'paper' && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const currentTeam = (await getCollection('team'))
  .filter((m) => m.data.role !== 'Alumni' && m.data.group !== 'india')
  .sort((a, b) => (a.data.weight || 100) - (b.data.weight || 100));

const sectionCards = [
  {
    href: '/team',
    icon: Users,
    label: 'People',
    description: "Meet the group's current members, the India-based forecasting team, and alumni.",
  },
  {
    href: '/publications',
    icon: BookOpen,
    label: 'Publications',
    description: 'Peer-reviewed research on monsoons, atmospheric dynamics, and extreme weather.',
  },
  {
    href: '/data-tools',
    icon: Database,
    label: 'Data & Tools',
    description: 'Operational forecasts, track datasets, and models produced by the group.',
  },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative h-[48vh] min-h-[360px] flex items-end overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image
        src={SITE.hero.image}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        quality={70}
        format="webp"
        widths={[640, 1024, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
      />
      <!-- Deep navy scrim: guarantees AA contrast for the title regardless of the image underneath -->
      <div class="absolute inset-0 bg-berkeley-scrim/80"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-8 sm:pb-10 w-full">
      <h1 class="text-3xl sm:text-5xl font-bold text-white leading-tight mb-3 max-w-3xl">
        {SITE.hero.title}
      </h1>
      <p class="text-base sm:text-xl text-berkeley-tint max-w-2xl">
        {SITE.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Section cards -->
  <section class="py-10 sm:py-12 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-3">
        {sectionCards.map((card) => (
          <a
            href={card.href}
            class="group bg-white dark:bg-gray-950 rounded-xl border border-gray-100 dark:border-gray-800 p-5 hover:shadow-md transition-all hover:-translate-y-0.5"
          >
            <div class="w-10 h-10 rounded-lg bg-berkeley-tint dark:bg-blue-950 text-berkeley-blue dark:text-blue-300 flex items-center justify-center mb-3">
              <card.icon className="w-5 h-5" aria-hidden="true" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1 group-hover:text-berkeley-link dark:group-hover:text-blue-400">
              {card.label}
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{card.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Team -->
  <section class="py-10 sm:py-12 bg-white dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Our team</h2>
        <a href="/team" class="text-berkeley-link dark:text-blue-300 hover:underline font-medium flex items-center gap-1 group">
          <span>Meet the full team</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-8">
        {currentTeam.map((member) => (
          <TeamCard member={member} />
        ))}
      </div>
    </div>
  </section>

  <!-- Selected Publications -->
  <section class="py-10 sm:py-12 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Selected publications</h2>
        <a href="/publications" class="text-berkeley-link dark:text-blue-300 hover:underline font-medium flex items-center gap-1 group">
          <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {papers.map((paper) => {
          const link = paper.data.links?.website || paper.data.links?.pdf || (paper.data.doi ? `https://doi.org/${paper.data.doi}` : '/publications');
          return (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white dark:bg-gray-950 rounded-xl border border-gray-100 dark:border-gray-800 hover:shadow-md transition-all hover:-translate-y-1 p-5 flex flex-col h-full group"
            >
              <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-2 line-clamp-3 group-hover:text-berkeley-link dark:group-hover:text-blue-400 transition-colors">
                {paper.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 mb-3 text-sm line-clamp-2 flex-grow" title={paper.data.authors.join(', ')}>
                {paper.data.authors.length > 3
                  ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.`
                  : paper.data.authors.join(', ')}
              </p>
              <div class="flex items-center justify-between text-sm mt-auto gap-4">
                <span class="font-medium text-berkeley-link dark:text-blue-300 bg-berkeley-tint dark:bg-blue-950 px-2 py-1 rounded truncate max-w-full" title={paper.data.venue}>
                  {paper.data.venue}
                </span>
                <span class="text-gray-500 dark:text-gray-400 shrink-0">{paper.data.year}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="py-10 sm:py-12 bg-white dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Latest news</h2>
        <a href="/news" class="text-berkeley-link dark:text-blue-300 hover:underline font-medium flex items-center gap-1 group">
          <span>View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {news.map((item) => (
          <div class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-100 dark:border-gray-800 p-5">
            <time datetime={item.data.date.toISOString()} class="text-sm text-gray-500 dark:text-gray-400">
              {item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mt-1 mb-2 line-clamp-3">{item.data.title}</h3>
            {item.data.link && (
              <a href={item.data.link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-berkeley-link dark:text-blue-300 hover:underline">
                View on Bluesky
              </a>
            )}
          </div>
        ))}

        {news.length === 0 && (
          <p class="text-gray-500 dark:text-gray-400 italic">No news yet.</p>
        )}
      </div>
    </div>
  </section>
</Layout>
