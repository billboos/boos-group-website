---
import Layout from '../layouts/Layout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';

const allPapers = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const years = [...new Set(allPapers.map(p => p.data.year))];
---

<Layout title="Publications" description="Peer-reviewed research from the Boos research group on monsoons, atmospheric dynamics, and extreme weather.">
  <div class="max-w-4xl mx-auto px-4 py-10 sm:py-14">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">Publications</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        A collection of our research papers, conference proceedings, and journal articles.
      </p>
    </div>

    <div class="space-y-12">
      {years.map(year => (
        <div class="relative">
          <div class="sticky top-16 z-10 bg-white/90 dark:bg-gray-950/90 backdrop-blur py-2 mb-4 border-b border-gray-100 dark:border-gray-800">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{year}</h2>
          </div>
          <div class="space-y-2">
            {allPapers.filter(p => p.data.year === year).map(paper => (
              <PublicationItem entry={paper} />
            ))}
          </div>
        </div>
      ))}

      {allPapers.length === 0 && (
        <p class="text-gray-500 dark:text-gray-400 text-center py-12">No publications found. Add markdown files to src/content/publications/</p>
      )}
    </div>
  </div>
</Layout>
