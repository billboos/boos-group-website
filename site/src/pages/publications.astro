---
import Layout from '../layouts/Layout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';

const allPapers = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const years = [...new Set(allPapers.map(p => p.data.year))];
---

<Layout title="Publications" description="Peer-reviewed research from the Boos research group on monsoons, atmospheric dynamics, and extreme weather.">
  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Publications</h1>
    </div>

    <div class="space-y-4">
      {years.map(year => (
        <div class="relative">
          <div class="sticky top-16 z-10 bg-white/90 dark:bg-gray-950/90 backdrop-blur py-1.5 mb-1 border-b border-gray-100 dark:border-gray-800">
            <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">{year}</h2>
          </div>
          <div>
            {allPapers.filter(p => p.data.year === year).map(paper => (
              <PublicationItem entry={paper} />
            ))}
          </div>
        </div>
      ))}

      {allPapers.length === 0 && (
        <p class="text-gray-500 dark:text-gray-400 text-center py-12">No publications found. Add markdown files to src/content/publications/</p>
      )}
    </div>
  </div>
</Layout>
